{%- comment -%}
  Metafield-driven size chart.
  Reads product.metafields.custom.size_chart (type: JSON), shape:
    { "unit": "in",
      "columns": ["Size", "Chest", "Waist"],
      "rows": [["S", "34–36", "28–30"], ["M", "38–40", "31–33"]] }
  Renders nothing if the product has no chart, so it's safe on every product template.
{%- endcomment -%}

{%- liquid
  assign chart = product.metafields.custom.size_chart.value
-%}

{%- if chart and chart.rows.size > 0 -%}
  <div class="page-width size-chart">
    <button
      type="button"
      class="link size-chart__open"
      onclick="this.nextElementSibling.showModal()"
      aria-haspopup="dialog"
    >
      {{ section.settings.link_label | escape }}
    </button>

    <dialog class="size-chart__dialog color-{{ section.settings.color_scheme }}" aria-labelledby="SizeChartTitle-{{ section.id }}">
      <div class="size-chart__header">
        <h2 id="SizeChartTitle-{{ section.id }}" class="h4">
          {{ section.settings.heading | escape }}
          {%- if chart.unit != blank %} ({{ chart.unit | escape }}){% endif -%}
        </h2>
        <button type="button" class="size-chart__close" onclick="this.closest('dialog').close()" aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        </button>
      </div>

      <div class="size-chart__scroll">
        <table class="size-chart__table">
          <thead>
            <tr>
              {%- for col in chart.columns -%}
                <th scope="col">{{ col | escape }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row in chart.rows -%}
              <tr>
                {%- for cell in row -%}
                  {%- if forloop.first -%}
                    <th scope="row">{{ cell | escape }}</th>
                  {%- else -%}
                    <td>{{ cell | escape }}</td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </dialog>
  </div>

  <style>
    .size-chart__open { font-size: 1.4rem; cursor: pointer; background: none; border: 0; padding: 0; text-decoration: underline; color: rgb(var(--color-foreground)); }
    .size-chart__dialog { max-width: min(60rem, 92vw); width: 100%; border: 0; border-radius: 8px; padding: 2rem; background: rgb(var(--color-background)); color: rgb(var(--color-foreground)); }
    .size-chart__dialog::backdrop { background: rgba(0, 0, 0, 0.45); }
    .size-chart__header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
    .size-chart__header h2 { margin: 0; }
    .size-chart__close { background: none; border: 0; cursor: pointer; width: 2.4rem; height: 2.4rem; padding: 0; color: inherit; }
    .size-chart__close svg { width: 100%; height: 100%; }
    .size-chart__scroll { overflow-x: auto; margin-top: 1.6rem; }
    .size-chart__table { width: 100%; border-collapse: collapse; font-size: 1.4rem; }
    .size-chart__table th, .size-chart__table td { padding: 0.8rem 1rem; text-align: left; border-bottom: 1px solid rgba(var(--color-foreground), 0.12); white-space: nowrap; }
    .size-chart__table thead th { font-weight: 600; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Size chart",
  "tag": "section",
  "class": "section-size-chart",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Size guide" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size guide" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Size chart" }]
}
{% endschema %}
